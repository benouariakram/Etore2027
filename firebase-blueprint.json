{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Represents an e-commerce catalog item in ETTORE store",
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Unique identifier of the product"
        },
        "nameFr": {
          "type": "string",
          "description": "Product name in French",
          "maxLength": 300
        },
        "nameAr": {
          "type": "string",
          "description": "Product name in Arabic",
          "maxLength": 300
        },
        "price": {
          "type": "number",
          "description": "Unit price in Moroccan Dirhams (MAD)"
        },
        "oldPrice": {
          "type": "number",
          "description": "Original crossed out price if discounted"
        },
        "category": {
          "type": "string",
          "description": "Product category",
          "enum": ["chaussures", "soins", "maison"],
          "maxLength": 100
        },
        "inStock": {
          "type": "boolean",
          "description": "Whether the product is currently available"
        },
        "stock": {
          "type": "number",
          "description": "Remaining stock count"
        },
        "badge": {
          "type": "string",
          "description": "Marketing badge indicator",
          "enum": ["new", "exclusive", "luxury", "out", ""]
        },
        "isNew": {
          "type": "boolean",
          "description": "Whether the product is flagged as new arrival"
        },
        "rating": {
          "type": "number",
          "description": "Average review rating (1 to 5)"
        },
        "images": {
          "type": "array",
          "description": "List of SVG data URIs or image URLs"
        },
        "descFr": {
          "type": "string",
          "description": "Editorial description in French",
          "maxLength": 3000
        },
        "descAr": {
          "type": "string",
          "description": "Editorial description in Arabic",
          "maxLength": 3000
        },
        "sizes": {
          "type": "array",
          "description": "Available size options"
        },
        "colors": {
          "type": "array",
          "description": "Available hex color options"
        },
        "variantStock": {
          "type": "object",
          "description": "Per size and color quantity inventory map"
        },
        "position": {
          "type": "number",
          "description": "Display rank order in the product catalog"
        },
        "showOnHome": {
          "type": "boolean",
          "description": "Whether the product appears on the Home / Index page selection"
        },
        "videoUrl": {
          "type": "string",
          "description": "Optional video URL (YouTube, TikTok, Vimeo, Drive, Reel, or MP4)",
          "maxLength": 500
        },
        "costPrice": {
          "type": "number",
          "description": "Admin-only purchase or import cost in MAD for net profit calculation"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO last update timestamp",
          "maxLength": 50
        }
      },
      "required": ["id", "nameFr", "price", "stock", "category"]
    },
    "Order": {
      "title": "Order",
      "description": "Represents a cash on delivery (COD) customer order",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Order reference code (e.g., CMD-A8F2K9)",
          "pattern": "^CMD-[A-Z0-9]{6}$",
          "maxLength": 16
        },
        "date": {
          "type": "string",
          "description": "ISO timestamp of order placement",
          "maxLength": 50
        },
        "status": {
          "type": "string",
          "description": "Order fulfillment status",
          "enum": ["En attente", "Confirmée", "En cours", "Livrée", "Annulée"]
        },
        "customerName": {
          "type": "string",
          "description": "Customer full name",
          "minLength": 1,
          "maxLength": 200
        },
        "customerPhone": {
          "type": "string",
          "description": "Customer Moroccan mobile phone number",
          "pattern": "^(06|07)[0-9]{8}$",
          "maxLength": 15
        },
        "city": {
          "type": "string",
          "description": "Delivery city in Morocco",
          "maxLength": 100
        },
        "address": {
          "type": "string",
          "description": "Complete shipping street address",
          "minLength": 1,
          "maxLength": 500
        },
        "notes": {
          "type": "string",
          "description": "Optional delivery instructions",
          "maxLength": 500
        },
        "items": {
          "type": "array",
          "description": "Ordered products line items"
        },
        "subtotal": {
          "type": "number",
          "description": "Order subtotal before discount"
        },
        "discount": {
          "type": "number",
          "description": "Applied discount amount in MAD"
        },
        "promoCode": {
          "type": "string",
          "description": "Coupon code used",
          "maxLength": 40
        },
        "shippingFee": {
          "type": "number",
          "description": "Shipping fee billed to customer in MAD"
        },
        "realShippingCost": {
          "type": "number",
          "description": "Actual carrier delivery cost paid by the store for this city in MAD"
        },
        "shipment": {
          "type": "object",
          "description": "Carrier dispatch & live tracking metadata (Ozon Express, Cathedis, Amana)"
        },
        "total": {
          "type": "number",
          "description": "Total amount to pay on delivery"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment terms (e.g. COD)",
          "maxLength": 100
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last order modification",
          "maxLength": 50
        }
      },
      "required": ["id", "customerName", "customerPhone", "city", "address", "items", "total", "status"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Designates an authorized administrator UID",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user UID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Administrator email address",
          "maxLength": 150
        }
      },
      "required": ["uid", "email"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Storefront configuration settings (heroSlider, cms, testimonials, catalogMeta, coupons, adminConfig)",
      "type": "object",
      "properties": {
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last setting update"
        }
      }
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount promo coupon created by admin for customers",
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Unique coupon ID"
        },
        "code": {
          "type": "string",
          "description": "Uppercase promo code entered by customers",
          "maxLength": 40
        },
        "type": {
          "type": "string",
          "description": "Discount calculation type",
          "enum": ["percent", "fixed"]
        },
        "value": {
          "type": "number",
          "description": "Percentage (1-100) or fixed amount in MAD"
        },
        "minOrder": {
          "type": "number",
          "description": "Minimum subtotal in MAD required to apply the coupon"
        },
        "maxUses": {
          "type": "number",
          "description": "Maximum allowed redemptions (null or 0 for unlimited)"
        },
        "usedCount": {
          "type": "number",
          "description": "Current redemption count"
        },
        "expiresAt": {
          "type": "string",
          "description": "Optional YYYY-MM-DD expiration date"
        },
        "active": {
          "type": "boolean",
          "description": "Whether the coupon is currently active"
        },
        "description": {
          "type": "string",
          "description": "Optional internal note for the coupon",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp"
        }
      },
      "required": ["id", "code", "type", "value", "active"]
    },
    "Media": {
      "title": "Media",
      "description": "Persistent uploaded image data stored in Firestore across container restarts",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Filename identifier of the uploaded image",
          "maxLength": 200
        },
        "dataUrl": {
          "type": "string",
          "description": "Base64 Data URL of the optimized image",
          "maxLength": 1040000
        },
        "mimeType": {
          "type": "string",
          "description": "MIME type of the image"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of upload"
        }
      },
      "required": ["id", "dataUrl"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog products readable by anyone, writable by admin"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer COD orders creatable by customers, readable for tracking by ID, manageable by admin"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Storefront settings (heroSlider, cms, testimonials)"
    },
    "/media/{mediaId}": {
      "schema": "Media",
      "description": "Persistent uploaded images stored in Firestore"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Trusted administrative user accounts"
    }
  }
}
