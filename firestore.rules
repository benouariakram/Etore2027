rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: validate alphanumeric IDs
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email == "startime.iptv@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'nameFr', 'price', 'stock', 'category']) &&
        data.id is number &&
        data.nameFr is string && data.nameFr.size() > 0 && data.nameFr.size() <= 150 &&
        data.price is number && data.price >= 0 &&
        data.stock is number && data.stock >= 0 &&
        data.category in ['chaussures', 'soins', 'maison'];
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'customerName', 'customerPhone', 'city', 'address', 'items', 'total', 'status']) &&
        data.id is string && data.id.matches('^CMD-[A-Z0-9]{6}$') &&
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
        data.customerPhone is string && data.customerPhone.matches('^(06|07)[0-9]{8}$') &&
        data.city is string && data.city.size() <= 50 &&
        data.address is string && data.address.size() >= 5 && data.address.size() <= 300 &&
        data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
        data.total is number && data.total >= 0 &&
        data.status in ['En attente', 'Confirmée', 'En cours', 'Livrée', 'Annulée'];
    }

    // Products catalog: public read, admin write
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Orders: public create, single-order tracking get, admin list & status updates
    match /orders/{orderId} {
      allow create: if isValidId(orderId) &&
        incoming().id == orderId &&
        isValidOrder(incoming()) &&
        incoming().status == 'En attente';
      allow get: if isValidId(orderId);
      allow list: if isAdmin();
      allow update: if isAdmin() &&
        isValidId(orderId) &&
        incoming().id == existing().id &&
        incoming().total == existing().total &&
        incoming().status in ['En attente', 'Confirmée', 'En cours', 'Livrée', 'Annulée'] &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Admins registry
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if false;
    }
  }
}
