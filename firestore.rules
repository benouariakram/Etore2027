rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: validate alphanumeric IDs
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email == "startime.iptv@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'nameFr', 'price', 'stock', 'category']) &&
        data.id is number &&
        data.nameFr is string && data.nameFr.size() >= 1 && data.nameFr.size() <= 300 &&
        data.price is number && data.price >= 0 &&
        data.stock is number && data.stock >= 0 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 100;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'customerName', 'customerPhone', 'city', 'address', 'items', 'total', 'status']) &&
        data.id is string && data.id.size() >= 3 && data.id.size() <= 40 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 200 &&
        data.customerPhone is string && data.customerPhone.size() >= 8 && data.customerPhone.size() <= 25 &&
        data.city is string && data.city.size() >= 1 && data.city.size() <= 100 &&
        data.address is string && data.address.size() >= 1 && data.address.size() <= 500 &&
        data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
        data.total is number && data.total >= 0 &&
        data.status in ['En attente', 'Confirmée', 'En cours', 'Livrée', 'Annulée'];
    }

    function isValidMedia(data) {
      return data.keys().hasAll(['id', 'dataUrl']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 200 &&
        data.dataUrl is string && data.dataUrl.size() > 0 && data.dataUrl.size() <= 1040000;
    }

    // Products catalog: public read, validated write
    match /products/{productId} {
      allow get, list: if true;
      allow create, update: if isValidId(productId) && isValidProduct(incoming());
      allow delete: if isValidId(productId);
    }

    // Settings (slider, cms, testimonials): public read, validated write
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    // Media storage (persistent uploaded photos across container restarts)
    match /media/{mediaId} {
      allow get, list: if true;
      allow create, update: if isValidId(mediaId) && isValidMedia(incoming());
      allow delete: if isValidId(mediaId);
    }

    // Orders: validated create, read, status updates, and delete
    match /orders/{orderId} {
      allow get, list: if true;
      allow create: if isValidId(orderId) &&
        incoming().id == orderId &&
        isValidOrder(incoming());
      allow update: if isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().id == existing().id;
      allow delete: if isValidId(orderId);
    }

    // Admins registry
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if false;
    }
  }
}
